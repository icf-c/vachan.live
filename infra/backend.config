# Passed to `terraform init -backend-config=backend.config`. State on R2 in
# the vachan.live account, like the other sites.
#
# Endpoint and credentials come from the environment:
#   AWS_ENDPOINT_URL_S3   = https://<account id>.r2.cloudflarestorage.com
#   AWS_ACCESS_KEY_ID     = R2 API token access key id
#   AWS_SECRET_ACCESS_KEY = R2 API token secret
#
# R2 has one region, "auto". The skip_* flags stop the backend from calling
# AWS-only APIs (STS, IMDS, region list) that R2 does not implement. The
# bucket is created once with `just state-bucket`.
bucket                      = "tfstate-vachan"
key                         = "vachan.live/infra.tfstate"
region                      = "auto"
use_lockfile                = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true
